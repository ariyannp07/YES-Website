# ---------------------------------------------------------------------------
# YES website — environment
#
# Copy to .env.local and fill in. .env.local is gitignored; never commit a key.
# The Airtable token is read ONLY on the server (app/api/enter/route.ts and the
# build-time feed readers). It is never exposed to the browser — no key belongs
# in a NEXT_PUBLIC_ variable.
# ---------------------------------------------------------------------------

# --- Palette (build spec §4) -----------------------------------------------
# 'night' or 'paper'. Unset falls back to 'night'.
NEXT_PUBLIC_PALETTE=night

# Preview-only palette switcher so the owners can choose from screens.
# Leave unset (or 'false') in production.
NEXT_PUBLIC_SHOW_PALETTE_TOGGLE=true


# --- Airtable / AINS State --------------------------------------------------
# Until these are set the site still builds and renders: /enter accepts no
# submissions and says so plainly, /builders stays dark, and /alumni shows
# placeholder silhouettes. Nothing is mocked and nothing pretends to be real.
#
# Create a personal access token at https://airtable.com/create/tokens with
# scopes: data.records:read, data.records:write, schema.bases:read
# and access granted to the YES-OS base.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=

# Table + view names. Defaults match Boola's airtable/schema.ts.
AIRTABLE_PEOPLE_TABLE=People
AIRTABLE_LOG_TABLE=Log
AIRTABLE_CATALOG_VIEW=Public-Catalog-Feed
AIRTABLE_ALUMNI_VIEW=Alumni-Page-Feed

# --- Semantic search (xAI / Grok) -------------------------------------------
# Server-only. Powers /api/search over the builder directory. Without it the
# catalog still filters locally; only the "search by meaning" path is disabled.
#
# Model choice matters: grok-4.6 answers correctly but spends ~2.1k reasoning
# tokens and takes ~36s, which is unusable in a search box. The non-reasoning
# model returns the same top matches in ~1.3s. See app/api/search/route.ts.
XAI_API_KEY=
