# ---------------------------------------------------------------------------
# YES website — environment
#
# Copy to .env.local and fill in. .env.local is gitignored; never commit a key.
# The Airtable token is read only by server routes and build-time data scripts.
# It is never exposed to the browser — no key belongs in a NEXT_PUBLIC_ variable.
# ---------------------------------------------------------------------------

# --- Palette ---------------------------------------------------------------
# 'night' or 'paper'. Unset falls back to 'night'.
NEXT_PUBLIC_PALETTE=night

# Preview-only palette switcher so the owners can choose from screens.
# Leave unset (or 'false') in production.
NEXT_PUBLIC_SHOW_PALETTE_TOGGLE=true


# --- Airtable data ----------------------------------------------------------
# Until these are set the site still builds and renders: /enter accepts no
# submissions and says so plainly, /builders stays dark, and /catalog uses the
# checked-in public directory. Nothing is mocked and nothing pretends to be real.
#
# Create a personal access token at https://airtable.com/create/tokens and grant
# only the record access required in the intended base.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=

# Table and view names. These defaults are used by lib/airtable/client.ts.
AIRTABLE_PEOPLE_TABLE=People
AIRTABLE_LOG_TABLE=Log
AIRTABLE_CATALOG_VIEW=Public-Catalog-Feed
AIRTABLE_ALUMNI_VIEW=Alumni-Page-Feed

# Human owner recorded on intake audit rows. Set this when Airtable logging is on.
INTAKE_LOG_OWNER=

# --- Semantic search (xAI) --------------------------------------------------
# Server-only. Powers /api/search over the builder directory. Without it the
# catalog still filters locally; only the "search by meaning" path is disabled.
XAI_API_KEY=
